PROJECT_NAME           = "Almost QR Code Reader"
PROJECT_NUMBER         = "@PROJECT_VERSION@"
PROJECT_BRIEF          = "A small Model 2 QR decoder written in C++23"

OUTPUT_DIRECTORY       = "@CMAKE_BINARY_DIR@/docs"
HTML_OUTPUT            = html
GENERATE_HTML          = YES
GENERATE_LATEX         = NO

INPUT                  = "@PROJECT_SOURCE_DIR@/README.md" \
                         "@PROJECT_SOURCE_DIR@/qrcode/include/qrcode"
FILE_PATTERNS          = *.h *.md
RECURSIVE              = YES
USE_MDFILE_AS_MAINPAGE = "@PROJECT_SOURCE_DIR@/README.md"

EXTRACT_ALL            = NO
EXTRACT_PRIVATE        = NO
JAVADOC_AUTOBRIEF      = YES
MARKDOWN_SUPPORT       = YES

WARN_IF_UNDOCUMENTED   = YES
WARN_IF_DOC_ERROR      = YES
WARN_AS_ERROR          = YES
QUIET                  = YES
